{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "roomix-demo",
  "compatibility_date": "2026-10-01",
  // Pure static site: Workers Static Assets serves ./dist, SPA fallback to index.html
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
